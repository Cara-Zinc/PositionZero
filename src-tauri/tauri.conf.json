{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POSITION ZERO",
  "version": "0.1.0",
  "identifier": "com.zincara.positionzero",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "POSITION ZERO",
      "width": 1320,
      "height": 860,
      "minWidth": 760,
      "minHeight": 680,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/stockfish"],
    "resources": ["../public/models/*", "../public/ort/*"],
    "copyright": "Third-party notices included in THIRD_PARTY_NOTICES.md"
  }
}
