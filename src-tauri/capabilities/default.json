{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local capabilities for the POSITION ZERO main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/stockfish", "sidecar": true }]
    }
  ]
}
